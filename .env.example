# ── CORE ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,portal.kafloxengineering.com

# ── DATABASE (Azure PostgreSQL) ───────────────────────────────────────────────
DB_NAME=kaflox_portal
DB_USER=kaflox_admin
DB_PASSWORD=your-db-password
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_SSLMODE=require

# ── REDIS (Azure Cache for Redis) ─────────────────────────────────────────────
REDIS_URL=redis://your-redis.redis.cache.windows.net:6380/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://portal.kafloxengineering.com

# ── AZURE STORAGE ─────────────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_MEDIA_CONTAINER=project-media
AZURE_DOCUMENTS_CONTAINER=project-documents

# ── AZURE AD B2C ──────────────────────────────────────────────────────────────
AZURE_AD_B2C_TENANT=your-tenant.onmicrosoft.com
AZURE_AD_B2C_CLIENT_ID=your-client-id
AZURE_AD_B2C_CLIENT_SECRET=your-client-secret
AZURE_AD_B2C_POLICY=B2C_1_signupsignin

# ── AZURE COMMUNICATION SERVICES ──────────────────────────────────────────────
AZURE_COMM_CONNECTION_STRING=endpoint=https://your-comm.communication.azure.com/;accesskey=your-key
AZURE_COMM_SENDER_EMAIL=noreply@kafloxengineering.com
AZURE_COMM_SENDER_PHONE=+1234567890

# ── AZURE OPENAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── FLUTTERWAVE ───────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
